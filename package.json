{
  "name": "my-tier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "start": "node --import tsx server/index.ts --production",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "refresh:portraits": "node --import tsx scripts/refresh-portraits.ts",
    "cache:portraits": "node --import tsx scripts/cache-portraits.ts",
    "check:media": "node --import tsx scripts/check-media.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "express": "5.2.1",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "sharp": "^0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
